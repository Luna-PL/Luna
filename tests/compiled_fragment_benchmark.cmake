cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED LUNA_COMPILED_PROBE_EXECUTABLE)
    message(FATAL_ERROR "LUNA_COMPILED_PROBE_EXECUTABLE is required")
endif()
if(NOT DEFINED LUNA_COMPILED_PROBE_ITERATIONS)
    set(LUNA_COMPILED_PROBE_ITERATIONS 3)
endif()
if(NOT LUNA_COMPILED_PROBE_ITERATIONS MATCHES "^[0-9]+$" OR
   LUNA_COMPILED_PROBE_ITERATIONS LESS 1 OR LUNA_COMPILED_PROBE_ITERATIONS GREATER 10000000)
    message(FATAL_ERROR "compiled probe iterations must be 1..10000000")
endif()
execute_process(COMMAND "${LUNA_COMPILED_PROBE_EXECUTABLE}" --compiled-fragment-cost
        "${LUNA_COMPILED_PROBE_ITERATIONS}" 9
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 180)
if(NOT status EQUAL 0 OR NOT errors STREQUAL "")
    message(FATAL_ERROR "compiled probe failed (${status}): ${errors}")
endif()
set(probe_root "${CMAKE_CURRENT_LIST_DIR}/../benchmarks")
file(SHA256 "${probe_root}/compiled_fragment_benchmark.cpp" probe_hash)
set(workload_input "")
foreach(path IN ITEMS host/luna.package host/src/effects.luna luna.lock luna.workspace
                      plugin/luna.package plugin/src/effects.luna)
    file(SHA256 "${probe_root}/compiled_fragment/${path}" hash)
    string(APPEND workload_input "${path}:${hash}\n")
endforeach()
string(SHA256 workload_hash "${workload_input}")
foreach(required IN ITEMS "# protocol=luna.compiled-fragment-cost.v1"
        "# probe_sha256=${probe_hash}" "# workload_sha256=${workload_hash}"
        "# moonir_optimization=O2,llvm_optimization=adapter_default"
        "# candidate_count=4,host_order=resume_a/resume_b/resume_c/resume_d"
        "# correctness_checks=320,runtime_alive_during_samples=no"
        "# affinity=uncontrolled,power_policy=uncontrolled"
        "# timed_harness=case_branch+input_modulo+JIT_call+checksum"
        "round,position,case,ns_per_op,calls,checksum"
        "# verified_samples=81,position_balanced=yes")
    string(FIND "${output}" "${required}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "compiled probe lost protocol metadata: ${required}")
    endif()
endforeach()
foreach(key IN ITEMS git_commit build_type compiler cxx target data_layout)
    if(NOT output MATCHES "# ${key}=[^\r\n]+")
        message(FATAL_ERROR "compiled probe lost build metadata: ${key}")
    endif()
endforeach()
foreach(key IN ITEMS host_container_sha256 plugin_container_sha256)
    string(REGEX MATCH "# ${key}=([0-9a-f]+)" digest "${output}")
    string(LENGTH "${CMAKE_MATCH_1}" length)
    if(NOT length EQUAL 64)
        message(FATAL_ERROR "compiled probe lost artifact SHA-256: ${key}")
    endif()
endforeach()
foreach(key IN ITEMS compile_encode_decode_ms verified_load_jit_ms discovery_binding_ms)
    if(NOT output MATCHES "# ${key}=[0-9]+[.][0-9]+")
        message(FATAL_ERROR "compiled probe lost setup observation: ${key}")
    endif()
endforeach()
set(warmup ${LUNA_COMPILED_PROBE_ITERATIONS})
if(warmup GREATER 1000)
    set(warmup 1000)
endif()
string(FIND "${output}" "# iterations=${LUNA_COMPILED_PROBE_ITERATIONS},warmup=${warmup},rounds=9" found)
if(found EQUAL -1)
    message(FATAL_ERROR "compiled probe reported incorrect sampling configuration")
endif()
math(EXPR calls "${LUNA_COMPILED_PROBE_ITERATIONS} + ${warmup}")
set(base_checksum 0)
foreach(count IN ITEMS ${LUNA_COMPILED_PROBE_ITERATIONS} ${warmup})
    math(EXPR full "${count} / 1024")
    math(EXPR remainder "${count} % 1024")
    math(EXPR checksum "3 * (${full} * 523776 + ${remainder} * (${remainder} - 1) / 2)")
    math(EXPR base_checksum "${base_checksum} + ${checksum}")
endforeach()
math(EXPR resumed_checksum "${base_checksum} + 17 * ${calls}")
set(cases plain private_erased static_resume static_discard dynamic_none dynamic_one
    dynamic_chain_2 dynamic_chain_4 dynamic_override_none)
string(REPLACE "\r\n" "\n" normalized "${output}")
string(REPLACE "\n" ";" lines "${normalized}")
set(samples 0)
foreach(line IN LISTS lines)
    if(line MATCHES "^[0-9]")
        math(EXPR round "${samples} / 9 + 1")
        math(EXPR position "${samples} % 9 + 1")
        math(EXPR case_index "(${position} - 1 + (${round} - 1) * 4) % 9")
        list(GET cases ${case_index} case_name)
        set(checksum ${resumed_checksum})
        if(case_index EQUAL 3)
            set(checksum ${base_checksum})
        endif()
        if(NOT line MATCHES "^${round},${position},${case_name},[0-9]+[.][0-9],${calls},${checksum}$")
            message(FATAL_ERROR "compiled schedule/calls/checksum mismatch: ${line}")
        endif()
        set(visit "${case_index}_${position}")
        if(DEFINED seen_${visit})
            message(FATAL_ERROR "compiled probe repeated a case/position: ${visit}")
        endif()
        set(seen_${visit} TRUE)
        math(EXPR samples "${samples} + 1")
    elseif(NOT line STREQUAL "" AND NOT line MATCHES "^#" AND NOT line MATCHES "^round,position,")
        message(FATAL_ERROR "unexpected compiled probe output: ${line}")
    endif()
endforeach()
if(NOT samples EQUAL 81)
    message(FATAL_ERROR "compiled probe emitted ${samples} samples, expected 81")
endif()
execute_process(COMMAND "${LUNA_COMPILED_PROBE_EXECUTABLE}" --compiled-fragment-cost 1 1
    RESULT_VARIABLE status OUTPUT_VARIABLE partial ERROR_VARIABLE errors TIMEOUT 30)
if(NOT status EQUAL 0 OR NOT errors STREQUAL "" OR
   NOT partial MATCHES "# verified_samples=9,position_balanced=no")
    message(FATAL_ERROR "partial compiled schedule incorrectly reported balance")
endif()
foreach(arguments IN ITEMS "--unknown" "--compiled-fragment-cost|-1"
        "--compiled-fragment-cost|3junk" "--compiled-fragment-cost|18446744073709551616"
        "--compiled-fragment-cost|0" "--compiled-fragment-cost|10000001"
        "--compiled-fragment-cost|3|0" "--compiled-fragment-cost|3|-1"
        "--compiled-fragment-cost|3|91" "--compiled-fragment-cost|3|9|extra")
    string(REPLACE "|" ";" arguments "${arguments}")
    execute_process(COMMAND "${LUNA_COMPILED_PROBE_EXECUTABLE}" ${arguments}
        RESULT_VARIABLE status OUTPUT_VARIABLE invalid_output ERROR_VARIABLE errors TIMEOUT 10)
    if(NOT status EQUAL 1 OR NOT invalid_output STREQUAL "" OR errors STREQUAL "")
        message(FATAL_ERROR "invalid compiled CLI accepted: ${arguments}")
    endif()
endforeach()
if(DEFINED LUNA_COMPILED_PROBE_RECORD)
    file(WRITE "${LUNA_COMPILED_PROBE_RECORD}" "${output}")
endif()
message(STATUS "Compiled Fragment probe: 81 samples, exact calls/checksums, balanced positions; no timing threshold")
