fn choose<T>(value: T, fallback: T, use_value: bool) -> T {
    if use_value {
        return value;
    } else {
        return fallback;
    }
}

fn first<T>(values: array<T, 2>) -> T {
    return values[0];
}

fn calculate<T>(unused: T) -> i32 {
    let values: array<i32, 3> = [4, 5, 6];
    let index: i32 = 0;
    while index < 1 {
        values[index] = values[index] + 1;
        index = index + 1;
    }
    return values[0];
}

fn main() -> i32 {
    let selected = choose::<i32>(first::<i32>([40, 41]), 9, true);
    return selected + calculate::<bool>(false) - 3;
}
