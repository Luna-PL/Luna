fn main() -> i32 {
    let values = [1, 2, 3, 4, 5];

    let total = values.iter()
        .map(fn(value: &i32) -> i32 { return *value * 2; })
        .filter(fn(value: i32) -> bool { return value > 4; })
        .take(2)
        .fold(0, fn(sum: i32, value: i32) -> i32 {
            return sum + value;
        });
    print(total);

    for value in range(2, 5)
        .map(fn(value: i32) -> i32 { return value * 10; }) {
        print(value);
    }

    let selected = values.iter()
        .filter(fn(value: &i32) -> bool { return *value >= 3; })
        .count();
    print(selected);

    values.iter().for_each(fn(value: &i32) -> unit {
        print(*value);
        return;
    });

    let direct_values = [6, 7];
    for direct in direct_values {
        print(direct);
        direct_values[1] = 70;
    }
    print(direct_values[1]);

    let consumed_values = [8, 9];
    for consumed in consumed_values.into_iter() {
        print(consumed);
        consumed_values[1] = 90;
    }
    print(consumed_values[1]);

    for value in values.iter_mut() {
        *value += 10;
    }
    print(values[0]);
    print(values[4]);
    return total;
}
