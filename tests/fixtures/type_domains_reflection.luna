struct Point { x: i32; }
struct UserId { value: i32; }
meta version { major: i32; }

fn main() -> i32 {
    if type_is_nominal::<Point>() {
        if type_is_nominal::<UserId>() {
            if type_is_meta::<version>() {
                print(type_domain::<version>());
                print(type_id::<Point>());
                print(type_shape::<UserId>());
                return 42;
            }
        }
    }
    return 1;
}
