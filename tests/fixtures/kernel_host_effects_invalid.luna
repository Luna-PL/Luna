// Device kernels may perform scalar control flow and device-buffer operations,
// but never host continuation, allocation, synchronization, or cleanup effects.
context passthrough {
    resume();
}

kernel fn invalid(index: i32, data: &mut device_buffer<i32>) {
    slot context checkpoint {
        gpu_store_i32(data, index, index);
    }
    apply checkpoint(passthrough) {
        checkpoint() {
            gpu_store_i32(data, index, index);
        }
    }
    resume();
    abort();
    await index;
    free data;
    let host_allocation = new i32(index);
}

fn main() -> i32 {
    return 0;
}
