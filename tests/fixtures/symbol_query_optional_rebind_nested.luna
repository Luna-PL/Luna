meta release { major: i32; }

@release(1)
fn answer() -> i32 { return 42; }

fn main() -> i32 {
    let original = symbols(answer).optional();
    let candidate = original;
    match candidate {
        None => {
            return 1;
        },
        Some(selected) => {
            let missing = symbols(answer)
                .matching(release(2)).optional();
            match missing {
                None => {
                    return selected() + 7;
                },
                Some(unreachable) => {
                    print(declaration_id(unreachable));
                    return unreachable();
                }
            }
        }
    }
}
