struct FragmentResource {
    marker: i32;
}

impl Drop for FragmentResource {
    fn drop(resource: &mut FragmentResource) -> unit {
        print(resource.marker);
    }
}

slot hook();

fragment stop[resource: FragmentResource] for hook {
    return;
    print(99);
}

fn main() -> i32 {
    apply stop[new FragmentResource(11)] {
        hook() {
            print(22);
        }
        print(33);
    }
    return 0;
}
