struct Resource {
    marker: i32;
}

impl Drop for Resource {
    fn drop(resource: &mut Resource) -> unit {
    }
}

fn main() -> i32 {
    let resource = new Resource(1);
    let values = [move resource];
    for item in values {
        print(item.marker);
    }
    print(values[0].marker);
    return 0;
}
