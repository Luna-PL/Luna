slot guarded(flag: bool);

fragment guard(flag: bool) for guarded {
    if flag {
        // Falling through discards the continuation on this path.
        print(1);
    } else {
        resume;
    }
}

fn main() -> i32 {
    let data = gpu_alloc_i32(1);
    apply guard {
        guarded(true) {
            gpu_free(move data);
        }
    }
    return 0;
}
