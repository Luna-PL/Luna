slot context guarded(flag: bool);

context guard(flag: bool) for guarded {
    if flag {
        abort();
    } else {
        resume();
    }
}

fn main() -> i32 {
    let data = gpu_alloc_i32(1);
    apply guard {
        guarded(true) {
            gpu_free(move data);
        }
    }
    return 0;
}
