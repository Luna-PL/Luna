slot interceptor first();
slot context second();
slot context third();

interceptor audit for first {
    print(10);
}

context around for second {
    print(20);
    resume();
    print(30);
}

context reject for third {
    print(40);
    abort();
}

fn main() -> i32 {
    apply audit {
        first() {
            print(11);
        }
    }
    apply around {
        second() {
            print(21);
        }
    }
    apply reject {
        third() {
            print(99);
        }
        print(41);
    }
    return 0;
}
