slot first();
slot second();
slot third();

fragment audit for first {
    print(10);
    resume;
}

fragment around for second {
    print(20);
    resume;
    print(30);
}

fragment reject for third {
    print(40);
}

fn main() -> i32 {
    apply audit {
        first() {
            print(11);
        }
    }
    apply around {
        second() {
            print(21);
        }
    }
    apply reject {
        third() {
            print(99);
        }
        print(41);
    }
    return 0;
}
