package org.luna.core;
module error;

// Stable, host-independent Core error identities. Numeric variant order is
// part of the frozen inline ADT ABI; new cases must be appended.
export enum ErrorCode {
    InvalidArgument;
    OutOfBounds;
    InvalidUtf8;
    InvalidLayout;
    OutOfMemory;
}

export enum InvalidArgumentError {
    InvalidArgument(i32);
}

export enum BoundsError {
    Empty;
    OutOfBounds(usize, usize);
}

export enum UtfError {
    InvalidByte(usize, u8);
    Truncated(usize);
    InvalidScalar(u32);
}

export enum LayoutError {
    SizeOverflow;
    InvalidAlignment(usize);
}

export enum AllocError {
    InvalidLayout(LayoutError);
    OutOfMemory(usize, usize);
}
