meta api_revision { value: i32; }

@api_revision(2)
trait Transform {
    fn transform(value: i32) -> i32;
}

impl Transform for i32 {
    fn transform(value: i32) -> i32 { return value + 2; }
}

fn keep<T>(value: T) -> T where T: Transform { return value; }

fn main() -> i32 {
    print(keep(8));
    return 0;
}
