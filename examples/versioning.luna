// Version is library-defined metadata. The compiler only understands the
// selector protocol and never applies SemVer/latest policy by itself.
meta release {
    channel: string;
    major: i32;
    minor: i32;
    patch: i32;
}

fn choose_release(view: declaration_view, channel: string,
                  major: i32, minor: i32, patch: i32) -> declaration_ref {
    return select_unique(view, release(channel, major, minor, patch));
}

@release("stable", 1, 0, 0)
fn greet() -> i32 { return 10; }

@release("stable", 1, 2, 0)
fn greet() -> i32 { return 12; }

@release("dev", 2, 0, 0)
fn greet() -> i32 { return 20; }

@release("stable", 1, 0, 0)
fn add_one(value: i32) -> i32 { return value + 1; }

@release("stable", 1, 1, 0)
fn add_one(value: i32) -> i32 { return value + 2; }

fn main() -> i32 {
    let stable = select greet with choose_release("stable", 1, 2, 0);
    print(stable());
    print(@choose_release("stable", 1, 0, 0) greet());
    print(@choose_release("stable", 1, 1, 0) add_one(5));
    return @choose_release("dev", 2, 0, 0) greet();
}
