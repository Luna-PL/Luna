package org.luna.examples.showcase.foundation;
module effects;

export slot audit_slot(value: i32);
export slot pipeline(value: i32);

runtime fn host_probe() -> i32 {
    let result = 40;
    audit_slot(1) {
        result += 2;
    }
    return result;
}

export fragment audit(value: i32) for audit_slot {
    print(value);
}

export fragment around(value: i32) for pipeline {
    print(value);
    resume;
}

export fragment trace(value: i32) for pipeline {
    print(value);
    resume;
}

export fragment observe(value: i32) for pipeline {
    print(value + 1);
    resume;
}
