struct Point {
    x: i32;
}

struct Pixel {
    x: i32;
}

fn accept(point: Point) -> i32 {
    return 1;
}

fn main() -> i32 {
    let pixel = new Pixel(1);
    // Point and Pixel have the same structural fields but different nominal
    // bindings, so this call must be rejected.
    return accept(pixel);
}
