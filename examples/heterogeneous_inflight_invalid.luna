// Expected ownership error: data remains exclusively in flight until await.
kernel fn write_one(index: i32, data: &mut device_buffer<i32>) {
    gpu_store_i32(data, index, 1);
}

fn main() -> i32 {
    linear let data = gpu_alloc_i32(1);
    let done = launch write_one[threads: 1](borrow mut data);
    gpu_store_i32(borrow mut data, 0, 2); // invalid: data is in flight
    await done;
    gpu_free(move data);
    return 0;
}
