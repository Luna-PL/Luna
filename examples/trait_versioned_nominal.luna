meta api_revision { value: i32; }

@api_revision(1)
struct Box { value: i32; }

@api_revision(1)
trait Tagged {
    fn validate(value: i32) -> i32;
}

impl Tagged for Box {
    fn validate(value: i32) -> i32 { return value; }
}

fn retain<T>(affine value: T) -> affine T where T: Tagged { return value; }

fn main() -> i32 {
    let first = new Box(7);
    let retained = retain(move first);
    return 0;
}
