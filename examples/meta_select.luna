// Metadata schemas are source-level types.  Attachments are compile-time-only
// unless the attachment is prefixed with `runtime` or `dynamic`.
meta version {
    major: i32;
    minor: i32;
    patch: i32;
}

// The view is supplied by `select`, but it is a real iterable built-in value.
// The selector body is ordinary user policy rather than a compiler AST pattern.
fn choice(view: declaration_view, major: i32, minor: i32, patch: i32) -> declaration_ref {
    let fallback = declaration_at(view, 0);
    for candidate in view {
        for attached in metadata::<version>(candidate) {
            if attached.major == major &&
               attached.minor == minor &&
               attached.patch == patch {
                return candidate;
            }
        }
    }
    return fallback;
}

@version(1, 0, 0)
fn answer() -> i32 {
    return 10;
}

@version(2, 0, 0)
fn answer() -> i32 {
    return 20;
}

fn main() -> i32 {
    let selected = select answer with choice(1, 0, 0);
    print(selected());
    print(@choice(2, 0, 0) answer());
    return @choice(2, 0, 0) answer();
}
