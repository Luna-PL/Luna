// An implicit-capture, multi-resume local slot.
context many twice {
    print(value);
    resume();
    print(value + 1);
    resume();
}

// An explicit reusable slot consumes the fragment's declared input interface.
context log(value) {
    print(value);
    resume();
}

context observe {
    print(value);
    resume();
}

fn main() -> i32 {
    let value = 10;
    apply local(twice) {
        slot context many local {
            print(value * 2);
        }
    }

    slot context pipeline(value: i32) default log;
    pipeline(7) {
        print(8);
    }

    // Statement-form apply lasts through the enclosing lexical scope.
    apply later(observe);
    slot context later {
        print(value + 2);
    }

    return 0;
}
