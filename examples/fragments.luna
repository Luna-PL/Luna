slot local();
slot pipeline(value: i32);
slot later();

// Every fragment is single-shot and nominally targets one slot.
fragment twice[value: i32] for local {
    print(value);
    resume;
}

// An explicit reusable slot consumes the fragment's declared input interface.
fragment log(value) for pipeline {
    print(value);
    resume;
}

fragment observe[value: i32] for later {
    print(value);
    resume;
}

fn main() -> i32 {
    let value = 10;
    apply twice[value] {
        local() {
            print(value * 2);
        }
    }

    apply log {
        pipeline(7) {
            print(8);
        }
    }

    apply observe[value] {
        later() {
            print(value + 2);
        }
    }

    return 0;
}
