slot context local();
slot context pipeline(value: i32) default log;
slot context later();

// Every 0.3 context is single-shot and nominally targets one slot.
context twice for local {
    print(value);
    resume();
}

// An explicit reusable slot consumes the fragment's declared input interface.
context log(value) for pipeline {
    print(value);
    resume();
}

context observe for later {
    print(value);
    resume();
}

fn main() -> i32 {
    let value = 10;
    apply twice {
        local() {
            print(value * 2);
        }
    }

    pipeline(7) {
        print(8);
    }

    apply observe {
        later() {
            print(value + 2);
        }
    }

    return 0;
}
