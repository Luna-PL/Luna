fn main() -> i32 {
    let checksum: i32 = 0;
    let i: i32 = 0;
    while i < 500000 {
        let item = new i32(i);
        // `new i32` is an owning heap value in Luna; scope exit releases it.
        // Unique heap values are ownership tokens in the Alpha surface; keep
        // the initializer live in the checksum while scope exit releases item.
        checksum = (checksum + i) % 1000003;
        i += 1;
    }
    print(checksum & 255);
    return 0;
}
