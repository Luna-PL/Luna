fn main() -> i32 {
    let values: array<i32, 8> = [1, 2, 3, 4, 5, 6, 7, 8];
    let i: i32 = 0;
    while i < 20000000 {
        let index = i & 7;
        values[index] = values[index] + (i & 31);
        i += 1;
    }
    let total: i32 = 0;
    let j: i32 = 0;
    while j < 8 {
        total += values[j];
        j += 1;
    }
    print(total & 255);
    return 0;
}
